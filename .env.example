# Required for the Rasa Pro image.
RASA_PRO_LICENSE=replace-with-your-rasa-pro-license

# The matching CALM setup uses Rasa's tutorial command-generator endpoint.
# No separate LLM key is required. If you configure a different provider,
# keep its key here and update endpoints.yml/config.yml accordingly.

# Optional: real concerts and shows near Salem. Free key at https://developer.ticketmaster.com
# (sign up, then copy the "Consumer Key"). Salem Public Library events load without any key.
TICKETMASTER_API_KEY=

# Optional: more public iCal feeds, as "Name|https://example.org/calendar.ics", comma-separated.
EXTRA_ICAL_FEEDS=

# Production only (set automatically by deploy/setup-server.sh): the public address Caddy serves with HTTPS.
BLOOM_DOMAIN=
