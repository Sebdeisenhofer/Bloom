{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "web",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-YOUR-BACKEND-URL/api/:path*" },
    { "source": "/webhooks/:path*", "destination": "https://REPLACE-WITH-YOUR-BACKEND-URL/webhooks/:path*" }
  ]
}
